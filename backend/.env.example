NODE_ENV=development
PORT=4000

# XAMPP MySQL (default: root, no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meto_db
DB_USER=root
DB_PASSWORD=

# Firebase Console → Project settings → Service accounts → Generate new private key
# File ko backend/secrets/ me rakho. Kabhi share ya commit mat karna.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Avatar uploads ka public URL base (phone pe adb reverse ke saath localhost chalega)
PUBLIC_BASE_URL=http://localhost:4000

# Agora video call — console.agora.io → Project → App ID / Primary Certificate
# Certificate SECRET hai: kabhi share ya commit mat karna
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
